@model IEnumerable<ProductCatalog.Models.Product>

<h1>Products</h1>
<p><a asp-action="Create">Add New Product</a></p>

<table>
	<thead>
		<tr><th>ID</th><th>Name</th><th>Price</th><th>Details</th></tr>
	</thead>
	<tbody>
		@foreach (var item in Model)
		{
			<tr>
				<td>@item.Id</td>
				<td>@item.Name</td>
				<td>@item.Price</td>
				<td><a asp-action="Details" asp-route-id="@item.Id">View</a></td>
			</tr>
		}
	</tbody>
</table>